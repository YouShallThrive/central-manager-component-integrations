# Convex deployment URL (set by init_app_project tool or npx convex dev)
VITE_CONVEX_URL=

# For local development with npx convex dev
# CONVEX_DEPLOY_KEY=

# Auth private key (RSA 2048, generated automatically)
# AUTH_PRIVATE_KEY=

# Self-hosted SMTP for email verification / password reset
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# Set "true" on preview/dev deployments to enable the @test.local provider
# IS_PREVIEW=true

# Shared secret for SSO token verification and internal credential APIs
# SSO_SHARED_SECRET=
